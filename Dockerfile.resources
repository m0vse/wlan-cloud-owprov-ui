FROM node:18.7.0-alpine3.15 AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN node test-resource-inheritance.cjs
RUN node test-bulk-push.cjs
RUN node test-radio-enable.cjs
RUN node test-6ghz-power-mode.cjs
RUN node test-auth-protocol.cjs
RUN node test-object-transfer.cjs
RUN node tests/private-pki/clipboard-test.cjs
RUN npm run build

FROM openwifi-owprov-ui:shinesystems-20260930 AS runtime
COPY --from=build /app/build/ /usr/share/nginx/html/
COPY --from=build /app/docker-entrypoint.d/owprov-ui-nginx.conf /etc/nginx/conf.d/default.conf
